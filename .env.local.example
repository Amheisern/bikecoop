# Copy to .env.local and fill in real values.
AUTH_USERNAME=coop
AUTH_PASSWORD=change-me
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Optional; defaults to ./bikecoop.db (a local file for development).
# DATABASE_PATH=./bikecoop.db

# Production (Render) only: the Turso database. When set, it's used instead
# of DATABASE_PATH. Get both from the Turso dashboard or CLI.
# TURSO_DATABASE_URL=libsql://bikecoop-yourname.turso.io
# TURSO_AUTH_TOKEN=...

# Slack shift signup (optional; see CLAUDE.md "Slack signup" and
# docs/slack-app-manifest.yml). Leave unset and nothing talks to Slack.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_CHANNEL_ID=C...

# Lapsed-member renewal emails (Resend). Leave unset for dry-run mode:
# the queue/log work fully, but emails are logged to the console, not sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM="St. Pete Bike Coop <members@example.org>"
